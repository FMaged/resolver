{
    "version": 1,
    "disable_existing_loggers": false,
    "formatters": {
        "default": {
            "format": "%(levelname)s - %(message)s"
        },
        "detailed": {
            "format": "%(asctime)s - %(name)s - %(levelname)s - %(message)s - [in %(pathname)s:%(lineno)d]",
            "datefmt": "%Y-%m-%d %H:%M:%S"
        },
        "json": {
            "()": "mylogger.JSONformatter",
            "fmt_keys": {
                "level": "levelname",
                "message": "message",
                "timestamp": "asctime",
                "logger": "name",
                "modules": "module",
                "function": "funcName",
                "line": "lineno",
                "thread": "threadName"
            }
        }
    },
    "handlers": {
        "st dout": {
            "class": "logging.StreamHandler",
            "formatter": "default",
            "level": "INFO",
            "stream": "ext://sys.stdout"
        },
        "stderr": {
            "class": "logging.StreamHandler",
            "formatter": "detailed",
            "level": "WARNING",
            "stream": "ext://sys.stderr"
        },
        "file": {
            "class": "logging.handlers.RotatingFileHandler",
            "formatter": "default",
            "level": "DEBUG",
            "filename": "resolver.log",
            "maxBytes": 10000,
            "backupCount": 5
            
        }
    },
    "loggers": {
        "root": {
            "level": "DEBUG",
            "handlers": [
                "stdout",
                "stderr", 
                "file"
            ]
        }
    }
}